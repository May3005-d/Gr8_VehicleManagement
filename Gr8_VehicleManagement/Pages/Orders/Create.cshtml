@page
@model Gr8_VehicleManagement.Pages.Orders.CreateModel
@{
    ViewData["Title"] = "Tạo Đơn Hàng Mới";
}

<div class="container-fluid mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/Orders">Đơn hàng</a></li>
            <li class="breadcrumb-item active">Tạo mới</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1><i class="bi bi-plus-circle"></i> Tạo Đơn Hàng Mới</h1>
            <p class="lead text-muted">Chọn khách hàng và xe để tạo đơn hàng</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="/Orders" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <form method="post">
        <div class="row">
            <!-- Customer Selection -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-person"></i> Chọn Khách Hàng</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Tìm kiếm khách hàng</label>
                            <input type="text" id="customerSearch" class="form-control" placeholder="Nhập tên, SĐT hoặc email..." />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Khách hàng</label>
                            <select asp-for="Input.CustomerId" class="form-select" required>
                                <option value="">-- Chọn khách hàng --</option>
                                @foreach (var customer in Model.Customers)
                                {
                                    <option value="@customer.Id">@customer.FullName - @customer.PhoneNumber</option>
                                }
                            </select>
                            <span asp-validation-for="Input.CustomerId" class="text-danger"></span>
                        </div>

                        <!-- Customer Info Display -->
                        <div id="customerInfo" class="mt-3" style="display: none;">
                            <div class="alert alert-info">
                                <h6><i class="bi bi-person-circle"></i> Thông tin khách hàng</h6>
                                <div id="customerDetails"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Vehicle Selection -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-car-front"></i> Chọn Xe</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Tìm kiếm xe</label>
                            <input type="text" id="vehicleSearch" class="form-control" placeholder="Nhập tên xe..." />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Phiên bản xe</label>
                            <select asp-for="Input.VersionId" class="form-select" required>
                                <option value="">-- Chọn phiên bản xe --</option>
                                @foreach (var version in Model.VehicleVersions)
                                {
                                    <option value="@version.Id" data-price="@version.Price" data-model="@version.ModelName">
                                        @version.ModelName - @version.VersionName (@version.ColorName) - @version.Price.ToString("N0") VNĐ
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="Input.VersionId" class="text-danger"></span>
                        </div>

                        <!-- Vehicle Info Display -->
                        <div id="vehicleInfo" class="mt-3" style="display: none;">
                            <div class="alert alert-info">
                                <h6><i class="bi bi-car-front"></i> Thông tin xe</h6>
                                <div id="vehicleDetails"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Details -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-cash-stack"></i> Thông Tin Đơn Hàng</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Đại lý</label>
                            <select asp-for="Input.DealerId" class="form-select" required>
                                <option value="">-- Chọn đại lý --</option>
                                @foreach (var dealer in Model.Dealers)
                                {
                                    <option value="@dealer.Id">@dealer.Name - @dealer.City</option>
                                }
                            </select>
                            <span asp-validation-for="Input.DealerId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Giá gốc (VNĐ)</label>
                            <input asp-for="Input.BasePrice" type="number" step="1000" class="form-control" readonly />
                            <span asp-validation-for="Input.BasePrice" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Giảm giá (VNĐ)</label>
                            <input asp-for="Input.DiscountAmount" type="number" step="1000" class="form-control" value="0" />
                            <span asp-validation-for="Input.DiscountAmount" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tổng tiền (VNĐ)</label>
                            <input asp-for="Input.TotalAmount" type="number" step="1000" class="form-control" readonly />
                            <span asp-validation-for="Input.TotalAmount" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Số tiền cọc (VNĐ)</label>
                            <input asp-for="Input.DepositAmount" type="number" step="1000" class="form-control" />
                            <span asp-validation-for="Input.DepositAmount" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Phương thức thanh toán</label>
                            <select asp-for="Input.PaymentMethod" class="form-select">
                                <option value="1">Trả thẳng</option>
                                <option value="2">Trả góp</option>
                            </select>
                            <span asp-validation-for="Input.PaymentMethod" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Dự kiến giao hàng</label>
                            <input asp-for="Input.ExpectedDeliveryDate" type="date" class="form-control" />
                            <span asp-validation-for="Input.ExpectedDeliveryDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ghi chú</label>
                            <textarea asp-for="Input.Notes" class="form-control" rows="3" placeholder="Ghi chú thêm..."></textarea>
                            <span asp-validation-for="Input.Notes" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Installment Info (hidden by default) -->
                <div id="installmentInfo" style="display: none;">
                    <hr />
                    <h6><i class="bi bi-credit-card"></i> Thông tin trả góp</h6>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Ngân hàng</label>
                                <input asp-for="Input.InstallmentProvider" class="form-control" placeholder="VD: Vietcombank" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Kỳ hạn (tháng)</label>
                                <input asp-for="Input.InstallmentTerm" type="number" class="form-control" placeholder="12, 24, 36..." />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Trả hàng tháng (VNĐ)</label>
                                <input asp-for="Input.MonthlyPayment" type="number" step="1000" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Lãi suất (%)</label>
                                <input asp-for="Input.InterestRate" type="number" step="0.01" class="form-control" placeholder="8.5" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-calculator"></i> Tóm Tắt Đơn Hàng</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th>Giá gốc:</th>
                                <td class="text-end" id="summaryBasePrice">0 VNĐ</td>
                            </tr>
                            <tr>
                                <th>Giảm giá:</th>
                                <td class="text-end text-danger" id="summaryDiscount">0 VNĐ</td>
                            </tr>
                            <tr class="border-top">
                                <th><strong>Tổng tiền:</strong></th>
                                <td class="text-end"><strong class="text-primary" id="summaryTotal">0 VNĐ</strong></td>
                            </tr>
                            <tr>
                                <th>Đã cọc:</th>
                                <td class="text-end" id="summaryDeposit">0 VNĐ</td>
                            </tr>
                            <tr>
                                <th><strong>Còn lại:</strong></th>
                                <td class="text-end"><strong class="text-warning" id="summaryRemaining">0 VNĐ</strong></td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <div id="summaryInstallment" style="display: none;">
                            <h6>Thông tin trả góp:</h6>
                            <table class="table table-borderless small">
                                <tr>
                                    <th>Ngân hàng:</th>
                                    <td id="summaryBank">-</td>
                                </tr>
                                <tr>
                                    <th>Kỳ hạn:</th>
                                    <td id="summaryTerm">-</td>
                                </tr>
                                <tr>
                                    <th>Trả hàng tháng:</th>
                                    <td id="summaryMonthly">-</td>
                                </tr>
                                <tr>
                                    <th>Lãi suất:</th>
                                    <td id="summaryRate">-</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Submit Buttons -->
        <div class="row">
            <div class="col-12 text-end">
                <a href="/Orders" class="btn btn-secondary me-2">
                    <i class="bi bi-x-circle"></i> Hủy
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Tạo Đơn Hàng
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Customer search
        document.getElementById('customerSearch').addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            const options = document.querySelectorAll('select[name="Input.CustomerId"] option');
            
            options.forEach(option => {
                if (option.value === '') return;
                const text = option.textContent.toLowerCase();
                option.style.display = text.includes(searchTerm) ? 'block' : 'none';
            });
        });

        // Vehicle search
        document.getElementById('vehicleSearch').addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            const options = document.querySelectorAll('select[name="Input.VersionId"] option');
            
            options.forEach(option => {
                if (option.value === '') return;
                const text = option.textContent.toLowerCase();
                option.style.display = text.includes(searchTerm) ? 'block' : 'none';
            });
        });

        // Vehicle selection change
        document.querySelector('select[name="Input.VersionId"]').addEventListener('change', function() {
            const selectedOption = this.options[this.selectedIndex];
            if (selectedOption.value) {
                const price = parseFloat(selectedOption.dataset.price);
                document.querySelector('input[name="Input.BasePrice"]').value = price;
                updateSummary();
                
                // Show vehicle info
                document.getElementById('vehicleInfo').style.display = 'block';
                document.getElementById('vehicleDetails').innerHTML = `
                    <strong>${selectedOption.dataset.model}</strong><br>
                    <small>Giá: ${price.toLocaleString()} VNĐ</small>
                `;
            } else {
                document.getElementById('vehicleInfo').style.display = 'none';
            }
        });

        // Payment method change
        document.querySelector('select[name="Input.PaymentMethod"]').addEventListener('change', function() {
            const installmentInfo = document.getElementById('installmentInfo');
            const summaryInstallment = document.getElementById('summaryInstallment');
            
            if (this.value === '2') {
                installmentInfo.style.display = 'block';
                summaryInstallment.style.display = 'block';
            } else {
                installmentInfo.style.display = 'none';
                summaryInstallment.style.display = 'none';
            }
        });

        // Update summary
        function updateSummary() {
            const basePrice = parseFloat(document.querySelector('input[name="Input.BasePrice"]').value) || 0;
            const discount = parseFloat(document.querySelector('input[name="Input.DiscountAmount"]').value) || 0;
            const deposit = parseFloat(document.querySelector('input[name="Input.DepositAmount"]').value) || 0;
            
            const total = basePrice - discount;
            const remaining = total - deposit;
            
            document.getElementById('summaryBasePrice').textContent = basePrice.toLocaleString() + ' VNĐ';
            document.getElementById('summaryDiscount').textContent = '-' + discount.toLocaleString() + ' VNĐ';
            document.getElementById('summaryTotal').textContent = total.toLocaleString() + ' VNĐ';
            document.getElementById('summaryDeposit').textContent = deposit.toLocaleString() + ' VNĐ';
            document.getElementById('summaryRemaining').textContent = remaining.toLocaleString() + ' VNĐ';
            
            // Update hidden total amount field
            document.querySelector('input[name="Input.TotalAmount"]').value = total;
        }

        // Bind events for summary updates
        document.querySelector('input[name="Input.DiscountAmount"]').addEventListener('input', updateSummary);
        document.querySelector('input[name="Input.DepositAmount"]').addEventListener('input', updateSummary);
    </script>
}
