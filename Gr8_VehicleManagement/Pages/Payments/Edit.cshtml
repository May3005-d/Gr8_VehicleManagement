@page
@model Gr8_VehicleManagement.Pages.Payments.EditModel
@{
    ViewData["Title"] = "Chỉnh Sửa Thanh Toán";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1><i class="bi bi-pencil"></i> Chỉnh Sửa Thanh Toán</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="/Payments/Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
            <a href="/Payments/Details?id=@Model.Payment.Id" class="btn btn-info">
                <i class="bi bi-eye"></i> Xem chi tiết
            </a>
        </div>
    </div>

    @if (Model.PaymentDetails != null)
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-credit-card"></i> Cập Nhật Thanh Toán</h5>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <input asp-for="Payment.Id" type="hidden" />
                            
                            <!-- Payment Info (Read-only) -->
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Mã Thanh Toán:</label>
                                        <p class="form-control-plaintext">@Model.PaymentDetails.PaymentNumber</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Số Tiền:</label>
                                        <p class="form-control-plaintext text-success fw-bold">@Model.PaymentDetails.Amount.ToString("N0") VNĐ</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Loại Thanh Toán:</label>
                                        <p class="form-control-plaintext">@Model.PaymentDetails.PaymentTypeDisplay</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Phương Thức:</label>
                                        <p class="form-control-plaintext">@Model.PaymentDetails.PaymentMethodTypeDisplay</p>
                                    </div>
                                </div>
                            </div>

                            <hr />

                            <!-- Editable Fields -->
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Trạng Thái <span class="text-danger">*</span></label>
                                        <select asp-for="Payment.Status" class="form-select" required>
                                            <option value="1" selected="@(Model.Payment.Status == Gr8_VehicleManagement.Data.Enums.PaymentStatus.Pending)">Chờ xử lý</option>
                                            <option value="3" selected="@(Model.Payment.Status == Gr8_VehicleManagement.Data.Enums.PaymentStatus.PaidInFull)">Đã thanh toán</option>
                                            <option value="4" selected="@(Model.Payment.Status == Gr8_VehicleManagement.Data.Enums.PaymentStatus.Refunded)">Đã hoàn tiền</option>
                                        </select>
                                        <span asp-validation-for="Payment.Status" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Mã Giao Dịch</label>
                                        <input asp-for="Payment.TransactionId" class="form-control" placeholder="Nhập mã giao dịch" />
                                        <span asp-validation-for="Payment.TransactionId" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Bằng Chứng Thanh Toán</label>
                                        <input asp-for="Payment.PaymentProof" class="form-control" placeholder="Link hoặc mô tả bằng chứng" />
                                        <span asp-validation-for="Payment.PaymentProof" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Phí Trễ Hạn</label>
                                        <input asp-for="Payment.LateFee" type="number" step="0.01" class="form-control" placeholder="Phí trễ hạn (nếu có)" />
                                        <span asp-validation-for="Payment.LateFee" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Lý Do Hoàn Tiền</label>
                                        <textarea asp-for="Payment.RefundReason" class="form-control" rows="3" placeholder="Lý do hoàn tiền (nếu có)"></textarea>
                                        <span asp-validation-for="Payment.RefundReason" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Ghi Chú</label>
                                <textarea asp-for="Payment.Notes" class="form-control" rows="3" placeholder="Ghi chú về thanh toán"></textarea>
                                <span asp-validation-for="Payment.Notes" class="text-danger"></span>
                            </div>

                            <div class="text-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle"></i> Cập Nhật
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Status Actions -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-gear"></i> Thao Tác Nhanh</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.PaymentDetails.Status == Gr8_VehicleManagement.Data.Enums.PaymentStatus.Pending)
                        {
                            <div class="mb-3">
                                <button type="button" class="btn btn-success w-100" onclick="updateStatus(3)">
                                    <i class="bi bi-check-circle"></i> Xác Nhận Thanh Toán
                                </button>
                            </div>
                        }
                        
                        @if (Model.PaymentDetails.Status == Gr8_VehicleManagement.Data.Enums.PaymentStatus.PaidInFull)
                        {
                            <div class="mb-3">
                                <button type="button" class="btn btn-warning w-100" onclick="updateStatus(1)">
                                    <i class="bi bi-arrow-clockwise"></i> Chuyển Về Chờ Xử Lý
                                </button>
                            </div>
                            <div class="mb-3">
                                <button type="button" class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#refundModal">
                                    <i class="bi bi-arrow-clockwise"></i> Hoàn Tiền
                                </button>
                            </div>
                        }
                        
                        @if (Model.PaymentDetails.Status == Gr8_VehicleManagement.Data.Enums.PaymentStatus.Refunded)
                        {
                            <div class="mb-3">
                                <button type="button" class="btn btn-info w-100" onclick="updateStatus(3)">
                                    <i class="bi bi-arrow-clockwise"></i> Khôi Phục Thanh Toán
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Payment History -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h5><i class="bi bi-clock-history"></i> Lịch Sử</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <small class="text-muted">Tạo lúc:</small><br />
                            <strong>@Model.PaymentDetails.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">Cập nhật lần cuối:</small><br />
                            <strong>@Model.PaymentDetails.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                        @if (Model.PaymentDetails.RefundApprovedAt.HasValue)
                        {
                            <div class="mb-2">
                                <small class="text-muted">Hoàn tiền lúc:</small><br />
                                <strong>@Model.PaymentDetails.RefundApprovedAt.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Refund Modal -->
        <div class="modal fade" id="refundModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Xác Nhận Hoàn Tiền</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Lý Do Hoàn Tiền:</label>
                            <textarea id="refundReason" class="form-control" rows="3" required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-danger" onclick="processRefund()">Xác Nhận Hoàn Tiền</button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-exclamation-triangle" style="font-size: 5rem; color: #dc3545;"></i>
            <p class="text-muted mt-3">Không tìm thấy thanh toán</p>
        </div>
    }
</div>

<script>
    function updateStatus(status) {
        const statusSelect = document.querySelector('select[name="Payment.Status"]');
        statusSelect.value = status;
        
        if (status === 4) { // Refunded
            const refundReason = prompt('Nhập lý do hoàn tiền:');
            if (refundReason) {
                document.querySelector('textarea[name="Payment.RefundReason"]').value = refundReason;
                document.querySelector('form').submit();
            }
        } else {
            document.querySelector('form').submit();
        }
    }

    function processRefund() {
        const reason = document.getElementById('refundReason').value;
        if (!reason.trim()) {
            alert('Vui lòng nhập lý do hoàn tiền');
            return;
        }
        
        document.querySelector('textarea[name="Payment.RefundReason"]').value = reason;
        document.querySelector('select[name="Payment.Status"]').value = '4';
        document.querySelector('form').submit();
    }
</script>
