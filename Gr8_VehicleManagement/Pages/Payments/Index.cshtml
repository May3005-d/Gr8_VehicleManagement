@page
@model Gr8_VehicleManagement.Pages.Payments.IndexModel
@{
    ViewData["Title"] = "Danh Sách Thanh Toán";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1 class="fade-in-up"><i class="bi bi-credit-card me-2"></i> Danh Sách Thanh Toán</h1>
        </div>
        <div class="col-md-6 text-end">
            @if (Model.CanCreate)
            {
                <a href="/Payments/Create" class="btn btn-primary btn-custom">
                    <i class="bi bi-plus-circle me-2"></i> Tạo Thanh Toán
                </a>
            }
        </div>
    </div>

    <!-- Search & Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Tìm kiếm</label>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Mã TT, tên KH, SĐT..." value="@Model.SearchTerm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Trạng thái</label>
                    <select name="status" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="1" selected="@(Model.Status == Gr8_VehicleManagement.Data.Enums.PaymentStatus.Pending)">Chờ xử lý</option>
                        <option value="3" selected="@(Model.Status == Gr8_VehicleManagement.Data.Enums.PaymentStatus.PaidInFull)">Đã thanh toán</option>
                        <option value="4" selected="@(Model.Status == Gr8_VehicleManagement.Data.Enums.PaymentStatus.Refunded)">Đã hoàn tiền</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Loại TT</label>
                    <select name="paymentType" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="1" selected="@(Model.PaymentType == Gr8_VehicleManagement.Data.Enums.PaymentType.Deposit)">Cọc</option>
                        <option value="2" selected="@(Model.PaymentType == Gr8_VehicleManagement.Data.Enums.PaymentType.Installment)">Trả góp</option>
                        <option value="3" selected="@(Model.PaymentType == Gr8_VehicleManagement.Data.Enums.PaymentType.FullPayment)">Trả thẳng</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Từ ngày</label>
                    <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Đến ngày</label>
                    <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Info -->
    <div class="row mb-3">
        <div class="col">
            <p class="text-muted">
                Hiển thị <strong>@Model.Payments.Count</strong> trong tổng số <strong>@Model.TotalCount</strong> thanh toán
            </p>
        </div>
    </div>

    <!-- Payments Table -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Mã TT</th>
                            <th>Ngày TT</th>
                            <th>Đơn hàng</th>
                            <th>Khách hàng</th>
                            <th>Số tiền</th>
                            <th>Loại TT</th>
                            <th>Trạng thái</th>
                            <th>Giao dịch</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.Payments)
                        {
                            <tr>
                                <td><strong>@payment.PaymentNumber</strong></td>
                                <td>@payment.PaymentDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a href="/Orders/Details?id=@payment.OrderId" class="text-decoration-none">
                                        @payment.OrderCode
                                    </a>
                                </td>
                                <td>
                                    <div>
                                        <strong>@payment.CustomerName</strong><br />
                                        <small class="text-muted">@payment.CustomerPhone</small>
                                    </div>
                                </td>
                                <td>
                                    <strong>@payment.Amount.ToString("N0") VNĐ</strong>
                                </td>
                                <td>
                                    @switch (payment.PaymentType)
                                    {
                                        case Gr8_VehicleManagement.Data.Enums.PaymentType.Deposit:
                                            <span class="badge bg-info">Cọc</span>
                                            break;
                                        case Gr8_VehicleManagement.Data.Enums.PaymentType.Installment:
                                            <span class="badge bg-warning">Trả góp</span>
                                            break;
                                        case Gr8_VehicleManagement.Data.Enums.PaymentType.FullPayment:
                                            <span class="badge bg-success">Trả thẳng</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @switch (payment.Status)
                                    {
                                        case Gr8_VehicleManagement.Data.Enums.PaymentStatus.Pending:
                                            <span class="badge bg-warning">Chờ xử lý</span>
                                            break;
                                        case Gr8_VehicleManagement.Data.Enums.PaymentStatus.PaidInFull:
                                            <span class="badge bg-success">Đã thanh toán</span>
                                            break;
                                        case Gr8_VehicleManagement.Data.Enums.PaymentStatus.Refunded:
                                            <span class="badge bg-danger">Đã hoàn tiền</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(payment.TransactionId))
                                    {
                                        <small class="text-muted">@payment.TransactionId</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <a href="/Payments/Details?id=@payment.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (Model.CanEdit)
                                    {
                                        <a href="/Payments/Edit?id=@payment.Id" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- No Results -->
    @if (Model.TotalCount == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-credit-card" style="font-size: 5rem; color: #ccc;"></i>
            <p class="text-muted mt-3">Không tìm thấy thanh toán nào</p>
        </div>
    }

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" href="?pageNumber=@(Model.PageNumber - 1)&searchTerm=@Model.SearchTerm&status=@Model.Status&paymentType=@Model.PaymentType&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")">
                        Trước
                    </a>
                </li>

                @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="?pageNumber=@i&searchTerm=@Model.SearchTerm&status=@Model.Status&paymentType=@Model.PaymentType&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" href="?pageNumber=@(Model.PageNumber + 1)&searchTerm=@Model.SearchTerm&status=@Model.Status&paymentType=@Model.PaymentType&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")">
                        Sau
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
