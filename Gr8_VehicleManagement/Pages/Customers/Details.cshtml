@page
@model Gr8_VehicleManagement.Pages.Customers.DetailsModel
@{
    ViewData["Title"] = Model.Customer?.FullName ?? "Chi Tiết Khách Hàng";
}

<div class="container-fluid mt-4">
    @if (Model.Customer == null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> Không tìm thấy khách hàng
        </div>
        <a href="/Customers" class="btn btn-secondary">Quay lại danh sách</a>
        return;
    }

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/Customers">Khách hàng</a></li>
            <li class="breadcrumb-item active">@Model.Customer.FullName</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1><i class="bi bi-person-circle"></i> @Model.Customer.FullName</h1>
            <p class="lead text-muted">
                @Model.Customer.Code | 
                @if (Model.Customer.CustomerType == Gr8_VehicleManagement.Data.Enums.CustomerType.Individual)
                {
                    <span>Cá nhân</span>
                }
                else
                {
                    <span>Doanh nghiệp</span>
                }
            </p>
        </div>
        <div class="col-md-4 text-end">
            @if (Model.CanEdit)
            {
                <a href="/Customers/Edit?id=@Model.Customer.Id" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Sửa
                </a>
            }
            @if (Model.CanCreateOrder)
            {
                <a href="/Orders/Create?customerId=@Model.Customer.Id" class="btn btn-success">
                    <i class="bi bi-cart-plus"></i> Tạo Đơn
                </a>
            }
        </div>
    </div>

    <!-- Statistics -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-primary">@Model.TotalOrders</h3>
                    <p class="text-muted mb-0">Đơn hàng</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-success">@Model.TotalSpent.ToString("N0")</h3>
                    <p class="text-muted mb-0">Tổng chi (VNĐ)</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-info">@Model.TestDriveCount</h3>
                    <p class="text-muted mb-0">Lái thử</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-warning">@Model.InteractionCount</h3>
                    <p class="text-muted mb-0">Tương tác</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Customer Info -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Thông Tin Cơ Bản</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="40%">Số điện thoại:</th>
                            <td><strong>@Model.Customer.PhoneNumber</strong></td>
                        </tr>
                        <tr>
                            <th>Email:</th>
                            <td>@(Model.Customer.Email ?? "-")</td>
                        </tr>
                        <tr>
                            <th>CMND/CCCD:</th>
                            <td>@(Model.Customer.IDNumber ?? "-")</td>
                        </tr>
                        <tr>
                            <th>Địa chỉ:</th>
                            <td>@(Model.Customer.Address ?? "-")</td>
                        </tr>
                        <tr>
                            <th>Quận/Huyện:</th>
                            <td>@(Model.Customer.District ?? "-")</td>
                        </tr>
                        <tr>
                            <th>Thành phố:</th>
                            <td>@(Model.Customer.City ?? "-")</td>
                        </tr>
                        <tr>
                            <th>Nguồn:</th>
                            <td>@(Model.Customer.Source ?? "-")</td>
                        </tr>
                        <tr>
                            <th>NV Phụ trách:</th>
                            <td>@(Model.Customer.AssignedSalesperson ?? "-")</td>
                        </tr>
                        <tr>
                            <th>Ngày liên hệ đầu:</th>
                            <td>@(Model.Customer.FirstContactDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                        </tr>
                        <tr>
                            <th>Ngày tạo:</th>
                            <td>@Model.Customer.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recent Interactions -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-chat-dots"></i> Tương Tác Gần Đây</h5>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                    @if (Model.Customer.RecentInteractions.Any())
                    {
                        @foreach (var interaction in Model.Customer.RecentInteractions)
                        {
                            <div class="border-bottom mb-2 pb-2">
                                <div class="d-flex justify-content-between">
                                    <strong>@interaction.Type</strong>
                                    <small class="text-muted">@interaction.Date.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <p class="mb-1">@interaction.Notes</p>
                                @if (!string.IsNullOrEmpty(interaction.ContactedBy))
                                {
                                    <small class="text-muted">Bởi: @interaction.ContactedBy</small>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Chưa có tương tác nào</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Test Drives -->
    @if (Model.Customer.TestDrives.Any())
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-car-front-fill"></i> Lịch Sử Lái Thử</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Ngày</th>
                                <th>Xe</th>
                                <th>Trạng thái</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var testDrive in Model.Customer.TestDrives)
                            {
                                <tr>
                                    <td>@testDrive.ScheduledDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@testDrive.VehicleName</td>
                                    <td>
                                        <span class="badge bg-@(testDrive.Status == "Completed" ? "success" : "warning")">
                                            @testDrive.Status
                                        </span>
                                    </td>
                                    <td>@(testDrive.Notes ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Orders -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-cart"></i> Đơn Hàng (@Model.Customer.Orders.Count)</h5>
        </div>
        <div class="card-body">
            @if (Model.Customer.Orders.Any())
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Mã ĐH</th>
                                <th>Ngày đặt</th>
                                <th>Xe</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>TT Thanh toán</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Customer.Orders)
                            {
                                <tr>
                                    <td><strong>@order.OrderCode</strong></td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                    <td>@order.VehicleName</td>
                                    <td><strong>@order.TotalAmount.ToString("N0") VNĐ</strong></td>
                                    <td><span class="badge bg-info">@order.Status</span></td>
                                    <td><span class="badge bg-warning">@order.PaymentStatus</span></td>
                                    <td>
                                        <a href="/Orders/Details?id=@order.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">Chưa có đơn hàng nào</p>
            }
        </div>
    </div>

    <!-- Back Button -->
    <div class="mb-4">
        <a href="/Customers" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>
</div>

