@page
@model Gr8_VehicleManagement.Pages.Customers.EditModel
@{
    ViewData["Title"] = "Sửa Khách Hàng";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/Customers">Khách hàng</a></li>
            <li class="breadcrumb-item"><a href="/Customers/Details?id=@Model.CustomerId">@Model.Input.FullName</a></li>
            <li class="breadcrumb-item active">Sửa</li>
        </ol>
    </nav>

    <h1><i class="bi bi-pencil"></i> Sửa Thông Tin Khách Hàng</h1>

    <div class="card mt-4">
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="CustomerId" />
                
                <div class="row">
                    <div class="col-md-6">
                        <h5>Thông Tin Cơ Bản</h5>
                        
                        <div class="mb-3">
                            <label asp-for="Input.FullName" class="form-label">Họ tên <span class="text-danger">*</span></label>
                            <input asp-for="Input.FullName" class="form-control" required />
                            <span asp-validation-for="Input.FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.PhoneNumber" class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                            <input asp-for="Input.PhoneNumber" class="form-control" required />
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <input asp-for="Input.Email" type="email" class="form-control" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.IDNumber" class="form-label">CMND/CCCD</label>
                            <input asp-for="Input.IDNumber" class="form-control" />
                            <span asp-validation-for="Input.IDNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.CustomerType" class="form-label">Loại khách hàng <span class="text-danger">*</span></label>
                            <select asp-for="Input.CustomerType" class="form-select" required>
                                <option value="">-- Chọn loại --</option>
                                <option value="0">Cá nhân</option>
                                <option value="1">Doanh nghiệp</option>
                            </select>
                            <span asp-validation-for="Input.CustomerType" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h5>Địa Chỉ</h5>

                        <div class="mb-3">
                            <label asp-for="Input.Address" class="form-label">Địa chỉ</label>
                            <textarea asp-for="Input.Address" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Input.Address" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.District" class="form-label">Quận/Huyện</label>
                            <input asp-for="Input.District" class="form-control" />
                            <span asp-validation-for="Input.District" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.City" class="form-label">Thành phố</label>
                            <select asp-for="Input.City" class="form-select">
                                <option value="">-- Chọn thành phố --</option>
                                <option value="Hà Nội">Hà Nội</option>
                                <option value="Hồ Chí Minh">Hồ Chí Minh</option>
                                <option value="Đà Nẵng">Đà Nẵng</option>
                                <option value="Hải Phòng">Hải Phòng</option>
                                <option value="Cần Thơ">Cần Thơ</option>
                            </select>
                            <span asp-validation-for="Input.City" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Source" class="form-label">Nguồn khách hàng</label>
                            <select asp-for="Input.Source" class="form-select">
                                <option value="">-- Chọn nguồn --</option>
                                <option value="Website">Website</option>
                                <option value="Facebook">Facebook</option>
                                <option value="Zalo">Zalo</option>
                                <option value="Walk-in">Walk-in</option>
                                <option value="Referral">Giới thiệu</option>
                                <option value="Phone">Điện thoại</option>
                            </select>
                            <span asp-validation-for="Input.Source" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.AssignedUserId" class="form-label">Nhân viên phụ trách</label>
                            <select asp-for="Input.AssignedUserId" class="form-select">
                                <option value="">-- Chọn nhân viên --</option>
                                @foreach (var user in Model.Salespeople)
                                {
                                    <option value="@user.Id">@user.FullName</option>
                                }
                            </select>
                            <span asp-validation-for="Input.AssignedUserId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between">
                    <a href="/Customers/Details?id=@Model.CustomerId" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Hủy
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Cập Nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

