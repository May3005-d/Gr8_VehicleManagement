@page
@model Gr8_VehicleManagement.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Đăng xuất";
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5">
                    <i class="bi bi-box-arrow-right text-primary" style="font-size: 4rem;"></i>
                    <h2 class="mt-3">Đăng xuất</h2>
                    <p class="text-muted">Bạn có chắc muốn đăng xuất khỏi hệ thống?</p>
                    
                    <form method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-lg me-2">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </button>
                        <a href="/" class="btn btn-secondary btn-lg">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

