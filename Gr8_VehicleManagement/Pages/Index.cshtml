@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="fade-in-up">
                    <h1 class="display-4 fw-bold mb-3 text-shadow">
                        <i class="bi bi-car-front text-warning me-3"></i>
                        Gr8 Vehicle Dealer
                    </h1>
                    <p class="lead mb-4 text-shadow">Hệ thống quản lý đại lý xe điện hiện đại và chuyên nghiệp</p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a href="/Vehicles" class="btn btn-warning btn-custom">
                            <i class="bi bi-car-front me-2"></i>Xem Xe
                        </a>
                        <a href="/Account/Login" class="btn btn-outline-light btn-custom">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng Nhập
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="fade-in-up" style="animation-delay: 0.2s;">
                    <img src="https://images.unsplash.com/photo-1563720223185-11003d516935?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" 
                         alt="Electric Vehicle" class="img-fluid rounded shadow-custom" style="max-height: 300px;">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="container py-5">
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="section-title fade-in-up">Tính Năng Nổi Bật</h2>
            <p class="section-subtitle fade-in-up" style="animation-delay: 0.1s;">Quản lý toàn diện hệ thống đại lý xe điện</p>
        </div>
    </div>
    
    <div class="row g-4">
        <div class="col-lg-4 col-md-6">
            <div class="feature-card">
                <div class="feature-icon bg-primary">
                    <i class="bi bi-car-front"></i>
                </div>
                <h5 class="fw-bold mb-2">Quản Lý Xe</h5>
                <p class="text-muted mb-3">Quản lý danh mục xe, thông tin chi tiết và hình ảnh</p>
                <a href="/Vehicles" class="btn btn-outline-primary btn-custom">Xem Chi Tiết</a>
            </div>
        </div>
        
        <div class="col-lg-4 col-md-6">
            <div class="feature-card">
                <div class="feature-icon bg-success">
                    <i class="bi bi-people"></i>
                </div>
                <h5 class="fw-bold mb-2">Quản Lý Khách Hàng</h5>
                <p class="text-muted mb-3">Theo dõi thông tin khách hàng và lịch sử mua hàng</p>
                <a href="/Customers" class="btn btn-outline-success btn-custom">Xem Chi Tiết</a>
            </div>
        </div>
        
        <div class="col-lg-4 col-md-6">
            <div class="feature-card">
                <div class="feature-icon bg-warning">
                    <i class="bi bi-cart"></i>
                </div>
                <h5 class="fw-bold mb-2">Quản Lý Đơn Hàng</h5>
                <p class="text-muted mb-3">Xử lý đơn hàng từ đặt hàng đến giao hàng</p>
                <a href="/Orders" class="btn btn-outline-warning btn-custom">Xem Chi Tiết</a>
            </div>
        </div>
        
        <div class="col-lg-4 col-md-6">
            <div class="feature-card">
                <div class="feature-icon bg-info">
                    <i class="bi bi-credit-card"></i>
                </div>
                <h5 class="fw-bold mb-2">Thanh Toán</h5>
                <p class="text-muted mb-3">Quản lý thanh toán và theo dõi trạng thái</p>
                <a href="/Payments" class="btn btn-outline-info btn-custom">Xem Chi Tiết</a>
            </div>
        </div>
        
        <div class="col-lg-4 col-md-6">
            <div class="feature-card">
                <div class="feature-icon bg-danger">
                    <i class="bi bi-gift"></i>
                </div>
                <h5 class="fw-bold mb-2">Khuyến Mãi</h5>
                <p class="text-muted mb-3">Quản lý chương trình khuyến mãi và giảm giá</p>
                <a href="/Orders" class="btn btn-outline-danger btn-custom">Xem Chi Tiết</a>
            </div>
        </div>
        
        <div class="col-lg-4 col-md-6">
            <div class="feature-card">
                <div class="feature-icon bg-secondary">
                    <i class="bi bi-graph-up"></i>
                </div>
                <h5 class="fw-bold mb-2">Báo Cáo</h5>
                <p class="text-muted mb-3">Thống kê và báo cáo doanh thu chi tiết</p>
                <a href="/Orders" class="btn btn-outline-secondary btn-custom">Xem Chi Tiết</a>
            </div>
        </div>
    </div>
</div>

<!-- Vehicle Showcase Section -->
<div class="bg-light-custom">
    <div class="container py-5">
        <div class="row mb-5">
            <div class="col-12">
                <h2 class="section-title fade-in-up">Xe Điện Nổi Bật</h2>
                <p class="section-subtitle fade-in-up" style="animation-delay: 0.1s;">Khám phá những mẫu xe điện mới nhất</p>
            </div>
        </div>
        
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="vehicle-card">
                    <img src="https://images.unsplash.com/photo-1593941707882-a5bac6861d75?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                         alt="Tesla Model 3">
                    <div class="p-3">
                        <h5 class="fw-bold">Tesla Model 3</h5>
                        <p class="text-muted small">Xe điện sedan cao cấp với công nghệ tiên tiến</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h6 text-primary mb-0">$45,000</span>
                            <a href="/Vehicles" class="btn btn-primary btn-custom">Xem Chi Tiết</a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="vehicle-card">
                    <img src="https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                         alt="BMW iX">
                    <div class="p-3">
                        <h5 class="fw-bold">BMW iX</h5>
                        <p class="text-muted small">SUV điện sang trọng với nội thất cao cấp</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h6 text-primary mb-0">$85,000</span>
                            <a href="/Vehicles" class="btn btn-primary btn-custom">Xem Chi Tiết</a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="vehicle-card">
                    <img src="https://images.unsplash.com/photo-1617788138017-80ad40651399?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                         alt="Audi e-tron">
                    <div class="p-3">
                        <h5 class="fw-bold">Audi e-tron</h5>
                        <p class="text-muted small">Crossover điện với thiết kế thể thao</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h6 text-primary mb-0">$65,000</span>
                            <a href="/Vehicles" class="btn btn-primary btn-custom">Xem Chi Tiết</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions Section -->
<div class="container py-5">
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="section-title fade-in-up">Truy Cập Nhanh</h2>
            <p class="section-subtitle fade-in-up" style="animation-delay: 0.1s;">Các chức năng quan trọng nhất</p>
        </div>
    </div>
    
    <div class="row g-4">
        <div class="col-lg-3 col-md-6">
            <a href="/Customers" class="text-decoration-none">
                <div class="feature-card">
                    <div class="feature-icon bg-primary">
                        <i class="bi bi-people"></i>
                    </div>
                    <h6 class="fw-bold">Khách Hàng</h6>
                    <p class="text-muted small">Quản lý khách hàng</p>
                </div>
            </a>
        </div>
        
        <div class="col-lg-3 col-md-6">
            <a href="/Dashboard" class="text-decoration-none">
                <div class="feature-card">
                    <div class="feature-icon bg-success">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                    <h6 class="fw-bold">Dashboard</h6>
                    <p class="text-muted small">Tổng quan hệ thống</p>
                </div>
            </a>
        </div>
        
        <div class="col-lg-3 col-md-6">
            <a href="/Account/Login" class="text-decoration-none">
                <div class="feature-card">
                    <div class="feature-icon bg-warning">
                        <i class="bi bi-box-arrow-in-right"></i>
                    </div>
                    <h6 class="fw-bold">Đăng Nhập</h6>
                    <p class="text-muted small">Truy cập hệ thống</p>
                </div>
            </a>
        </div>
        
        <div class="col-lg-3 col-md-6">
            <a href="/Vehicles" class="text-decoration-none">
                <div class="feature-card">
                    <div class="feature-icon bg-info">
                        <i class="bi bi-car-front"></i>
                    </div>
                    <h6 class="fw-bold">Xem Xe</h6>
                    <p class="text-muted small">Danh mục xe</p>
                </div>
            </a>
        </div>
    </div>
</div>