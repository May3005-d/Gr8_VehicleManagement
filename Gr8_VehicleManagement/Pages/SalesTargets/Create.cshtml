@page
@model Gr8_VehicleManagement.Pages.SalesTargets.CreateModel
@{
    ViewData["Title"] = "Tạo Chỉ Tiêu Bán Hàng";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-6">
            <h2 class="mb-0">
                <i class="bi bi-plus-circle"></i> Tạo Chỉ Tiêu Bán Hàng
            </h2>
            <p class="text-muted">Thiết lập chỉ tiêu và hoa hồng cho đại lý/nhân viên</p>
        </div>
        <div class="col-md-6 text-end">
            <a href="/SalesTargets" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i> Quay Lại
            </a>
        </div>
    </div>

    @if (!Model.CanCreate)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Bạn không có quyền tạo chỉ tiêu bán hàng.
        </div>
        return;
    }

    <!-- Create Form -->
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Thông Tin Chỉ Tiêu</h5>
                </div>
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Basic Information -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.Name" class="form-label">Tên Chỉ Tiêu <span class="text-danger">*</span></label>
                                <input asp-for="Input.Name" class="form-control" placeholder="Ví dụ: Chỉ tiêu Q1 2024" />
                                <span asp-validation-for="Input.Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.TargetFor" class="form-label">Loại Chỉ Tiêu <span class="text-danger">*</span></label>
                                <select asp-for="Input.TargetFor" class="form-select" id="targetForSelect">
                                    <option value="">-- Chọn loại chỉ tiêu --</option>
                                    <option value="Dealer">Đại lý</option>
                                    <option value="Staff">Nhân viên</option>
                                </select>
                                <span asp-validation-for="Input.TargetFor" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="Input.Description" class="form-label">Mô Tả</label>
                                <textarea asp-for="Input.Description" class="form-control" rows="3" placeholder="Mô tả chi tiết về chỉ tiêu..."></textarea>
                                <span asp-validation-for="Input.Description" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Target Assignment -->
                        <div class="row mb-3">
                            <div class="col-md-6" id="dealerSelection" style="display: none;">
                                <label asp-for="Input.DealerId" class="form-label">Đại Lý <span class="text-danger">*</span></label>
                                <select asp-for="Input.DealerId" class="form-select">
                                    <option value="">-- Chọn đại lý --</option>
                                    @foreach (var dealer in Model.Dealers)
                                    {
                                        <option value="@dealer.Id">@dealer.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="Input.DealerId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6" id="userSelection" style="display: none;">
                                <label asp-for="Input.UserId" class="form-label">Nhân Viên <span class="text-danger">*</span></label>
                                <select asp-for="Input.UserId" class="form-select">
                                    <option value="">-- Chọn nhân viên --</option>
                                    @foreach (var user in Model.Users)
                                    {
                                        <option value="@user.Id">@user.FullName</option>
                                    }
                                </select>
                                <span asp-validation-for="Input.UserId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Target Values -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.TargetAmount" class="form-label">Chỉ Tiêu Doanh Số (VNĐ) <span class="text-danger">*</span></label>
                                <input asp-for="Input.TargetAmount" class="form-control" type="number" step="0.01" min="0" placeholder="1000000000" />
                                <span asp-validation-for="Input.TargetAmount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.TargetQuantity" class="form-label">Chỉ Tiêu Số Lượng (Xe) <span class="text-danger">*</span></label>
                                <input asp-for="Input.TargetQuantity" class="form-control" type="number" min="0" placeholder="50" />
                                <span asp-validation-for="Input.TargetQuantity" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Commission -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.CommissionRate" class="form-label">Tỷ Lệ Hoa Hồng (%) <span class="text-danger">*</span></label>
                                <input asp-for="Input.CommissionRate" class="form-control" type="number" step="0.01" min="0" max="100" placeholder="2.5" />
                                <span asp-validation-for="Input.CommissionRate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Hoa Hồng Ước Tính</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="estimatedCommission" readonly placeholder="Tự động tính" />
                                    <span class="input-group-text">VNĐ</span>
                                </div>
                                <small class="form-text text-muted">Hoa hồng = Doanh số × Tỷ lệ %</small>
                            </div>
                        </div>

                        <!-- Date Range -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.StartDate" class="form-label">Ngày Bắt Đầu <span class="text-danger">*</span></label>
                                <input asp-for="Input.StartDate" class="form-control" type="date" />
                                <span asp-validation-for="Input.StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.EndDate" class="form-label">Ngày Kết Thúc <span class="text-danger">*</span></label>
                                <input asp-for="Input.EndDate" class="form-control" type="date" />
                                <span asp-validation-for="Input.EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" />
                                    <label asp-for="Input.IsActive" class="form-check-label">
                                        Kích hoạt chỉ tiêu ngay
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="row">
                            <div class="col-md-12">
                                <hr>
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="/SalesTargets" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle me-2"></i> Hủy
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check-circle me-2"></i> Tạo Chỉ Tiêu
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Help Panel -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i> Hướng Dẫn
                    </h6>
                </div>
                <div class="card-body">
                    <h6>Loại Chỉ Tiêu:</h6>
                    <ul class="list-unstyled">
                        <li><strong>Đại lý:</strong> Chỉ tiêu cho toàn bộ đại lý</li>
                        <li><strong>Nhân viên:</strong> Chỉ tiêu cho nhân viên cụ thể</li>
                    </ul>

                    <h6>Tỷ Lệ Hoa Hồng:</h6>
                    <ul class="list-unstyled">
                        <li><strong>1-2%:</strong> Hoa hồng cơ bản</li>
                        <li><strong>2-5%:</strong> Hoa hồng khuyến khích</li>
                        <li><strong>5%+:</strong> Hoa hồng đặc biệt</li>
                    </ul>

                    <h6>Thời Gian:</h6>
                    <ul class="list-unstyled">
                        <li><strong>Tháng:</strong> 1 tháng</li>
                        <li><strong>Quý:</strong> 3 tháng</li>
                        <li><strong>Năm:</strong> 12 tháng</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('targetForSelect').addEventListener('change', function() {
            const targetFor = this.value;
            const dealerSelection = document.getElementById('dealerSelection');
            const userSelection = document.getElementById('userSelection');
            
            if (targetFor === 'Dealer') {
                dealerSelection.style.display = 'block';
                userSelection.style.display = 'none';
                document.getElementById('Input_UserId').value = '';
            } else if (targetFor === 'Staff') {
                dealerSelection.style.display = 'none';
                userSelection.style.display = 'block';
                document.getElementById('Input_DealerId').value = '';
            } else {
                dealerSelection.style.display = 'none';
                userSelection.style.display = 'none';
                document.getElementById('Input_DealerId').value = '';
                document.getElementById('Input_UserId').value = '';
            }
        });

        // Calculate estimated commission
        function calculateCommission() {
            const targetAmount = parseFloat(document.getElementById('Input_TargetAmount').value) || 0;
            const commissionRate = parseFloat(document.getElementById('Input_CommissionRate').value) || 0;
            const estimatedCommission = targetAmount * (commissionRate / 100);
            document.getElementById('estimatedCommission').value = estimatedCommission.toLocaleString('vi-VN');
        }

        document.getElementById('Input_TargetAmount').addEventListener('input', calculateCommission);
        document.getElementById('Input_CommissionRate').addEventListener('input', calculateCommission);
    </script>
}
