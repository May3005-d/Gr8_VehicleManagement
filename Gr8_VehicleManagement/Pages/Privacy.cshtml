@page
@model Gr8_VehicleManagement.Pages.PrivacyModel
@{
    ViewData["Title"] = "Bảo mật";
}

<div class="container-fluid">
    <!-- Hero Section -->
    <div class="row hero-section">
        <div class="col-12">
            <div class="hero-content text-center">
                <h1 class="display-4 fw-bold text-white mb-4">CHÍNH SÁCH BẢO MẬT</h1>
                <p class="lead text-white mb-5">Cam kết bảo vệ thông tin cá nhân của bạn</p>
            </div>
        </div>
    </div>

    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="privacy-content">
                    <!-- Introduction -->
                    <section class="mb-5">
                        <h2 class="text-primary mb-3">
                            <i class="fas fa-shield-alt me-2"></i>Giới thiệu
                        </h2>
                        <p class="text-muted">
                            GR8 Vehicle Management cam kết bảo vệ quyền riêng tư và thông tin cá nhân của khách hàng. 
                            Chính sách bảo mật này giải thích cách chúng tôi thu thập, sử dụng, lưu trữ và bảo vệ 
                            thông tin của bạn khi sử dụng dịch vụ của chúng tôi.
                        </p>
                        <p class="text-muted">
                            <strong>Cập nhật lần cuối:</strong> 01/01/2025
                        </p>
                    </section>

                    <!-- Information Collection -->
                    <section class="mb-5">
                        <h2 class="text-primary mb-3">
                            <i class="fas fa-database me-2"></i>1. Thông tin chúng tôi thu thập
                        </h2>
                        <div class="row">
                            <div class="col-md-6">
                                <h5>Thông tin cá nhân</h5>
                                <ul class="text-muted">
                                    <li>Họ và tên</li>
                                    <li>Địa chỉ email</li>
                                    <li>Số điện thoại</li>
                                    <li>Địa chỉ nhà/doanh nghiệp</li>
                                    <li>Thông tin tài khoản ngân hàng (nếu có)</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h5>Thông tin kỹ thuật</h5>
                                <ul class="text-muted">
                                    <li>Địa chỉ IP</li>
                                    <li>Thông tin trình duyệt</li>
                                    <li>Dữ liệu sử dụng hệ thống</li>
                                    <li>Cookies và công nghệ tương tự</li>
                                </ul>
                            </div>
                        </div>
                    </section>

                    <!-- Usage -->
                    <section class="mb-5">
                        <h2 class="text-primary mb-3">
                            <i class="fas fa-cogs me-2"></i>2. Cách sử dụng thông tin
                        </h2>
                        <div class="usage-grid">
                            <div class="usage-item">
                                <i class="fas fa-shopping-cart text-primary"></i>
                                <h5>Xử lý đơn hàng</h5>
                                <p>Xử lý và theo dõi các đơn hàng của bạn</p>
                            </div>
                            <div class="usage-item">
                                <i class="fas fa-headset text-primary"></i>
                                <h5>Hỗ trợ khách hàng</h5>
                                <p>Cung cấp dịch vụ hỗ trợ và tư vấn</p>
                            </div>
                            <div class="usage-item">
                                <i class="fas fa-bell text-primary"></i>
                                <h5>Thông báo</h5>
                                <p>Gửi thông báo về sản phẩm và dịch vụ</p>
                            </div>
                            <div class="usage-item">
                                <i class="fas fa-chart-line text-primary"></i>
                                <h5>Cải thiện dịch vụ</h5>
                                <p>Phân tích để nâng cao chất lượng dịch vụ</p>
                            </div>
                        </div>
                    </section>

                    <!-- Data Protection -->
                    <section class="mb-5">
                        <h2 class="text-primary mb-3">
                            <i class="fas fa-lock me-2"></i>3. Bảo vệ dữ liệu
                        </h2>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <div class="protection-card">
                                    <i class="fas fa-key text-primary mb-3" style="font-size: 2rem;"></i>
                                    <h5>Mã hóa SSL</h5>
                                    <p class="text-muted">Tất cả dữ liệu được mã hóa khi truyền tải</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="protection-card">
                                    <i class="fas fa-server text-primary mb-3" style="font-size: 2rem;"></i>
                                    <h5>Bảo mật server</h5>
                                    <p class="text-muted">Hệ thống server được bảo vệ 24/7</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="protection-card">
                                    <i class="fas fa-user-shield text-primary mb-3" style="font-size: 2rem;"></i>
                                    <h5>Kiểm soát truy cập</h5>
                                    <p class="text-muted">Chỉ nhân viên được ủy quyền mới có thể truy cập</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Cookies -->
                    <section class="mb-5">
                        <h2 class="text-primary mb-3">
                            <i class="fas fa-cookie-bite me-2"></i>4. Chính sách Cookie
                        </h2>
                        <p class="text-muted">
                            Chúng tôi sử dụng cookies để cải thiện trải nghiệm người dùng và phân tích lưu lượng truy cập. 
                            Bạn có thể tắt cookies trong trình duyệt, nhưng điều này có thể ảnh hưởng đến chức năng của website.
                        </p>
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Lưu ý:</strong> Cookies của chúng tôi không chứa thông tin cá nhân nhạy cảm và chỉ được sử dụng 
                            cho mục đích cải thiện dịch vụ.
                        </div>
                    </section>

                    <!-- User Rights -->
                    <section class="mb-5">
                        <h2 class="text-primary mb-3">
                            <i class="fas fa-user-check me-2"></i>5. Quyền của bạn
                        </h2>
                        <div class="rights-list">
                            <div class="right-item">
                                <i class="fas fa-eye text-success"></i>
                                <div>
                                    <h6>Quyền truy cập</h6>
                                    <p class="text-muted">Xem thông tin cá nhân chúng tôi lưu trữ</p>
                                </div>
                            </div>
                            <div class="right-item">
                                <i class="fas fa-edit text-warning"></i>
                                <div>
                                    <h6>Quyền chỉnh sửa</h6>
                                    <p class="text-muted">Cập nhật thông tin cá nhân không chính xác</p>
                                </div>
                            </div>
                            <div class="right-item">
                                <i class="fas fa-trash text-danger"></i>
                                <div>
                                    <h6>Quyền xóa</h6>
                                    <p class="text-muted">Yêu cầu xóa thông tin cá nhân</p>
                                </div>
                            </div>
                            <div class="right-item">
                                <i class="fas fa-download text-info"></i>
                                <div>
                                    <h6>Quyền xuất dữ liệu</h6>
                                    <p class="text-muted">Tải xuống dữ liệu cá nhân của bạn</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Contact -->
                    <section class="mb-5">
                        <h2 class="text-primary mb-3">
                            <i class="fas fa-envelope me-2"></i>6. Liên hệ về bảo mật
                        </h2>
                        <div class="contact-security">
                            <p class="text-muted">
                                Nếu bạn có câu hỏi về chính sách bảo mật này hoặc muốn thực hiện quyền của mình, 
                                vui lòng liên hệ với chúng tôi:
                            </p>
                            <div class="contact-info">
                                <div class="row">
                                    <div class="col-md-6">
                                        <p><strong>Email:</strong> privacy@gr8vehicle.com</p>
                                        <p><strong>Điện thoại:</strong> +84 123 456 789</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Địa chỉ:</strong> 123 Đường ABC, Quận XYZ</p>
                                        <p><strong>Thời gian:</strong> 8:00 - 18:00 (T2-T6)</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Updates -->
                    <section class="mb-5">
                        <h2 class="text-primary mb-3">
                            <i class="fas fa-sync-alt me-2"></i>7. Cập nhật chính sách
                        </h2>
                        <p class="text-muted">
                            Chúng tôi có thể cập nhật chính sách bảo mật này theo thời gian. Mọi thay đổi quan trọng 
                            sẽ được thông báo qua email hoặc thông báo trên website. Chúng tôi khuyến khích bạn 
                            thường xuyên xem lại chính sách này.
                        </p>
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Lưu ý:</strong> Việc tiếp tục sử dụng dịch vụ sau khi có thay đổi chính sách 
                            được coi là bạn đồng ý với các điều khoản mới.
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.hero-section {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 100px 0;
    margin-bottom: 0;
}

.privacy-content {
    background: white;
    padding: 40px;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.usage-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.usage-item {
    text-align: center;
    padding: 20px;
    background: #f8f9fa;
    border-radius: 10px;
    transition: transform 0.3s ease;
}

.usage-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

.usage-item i {
    font-size: 2rem;
    margin-bottom: 15px;
    display: block;
}

.protection-card {
    text-align: center;
    padding: 30px 20px;
    background: #f8f9fa;
    border-radius: 15px;
    transition: transform 0.3s ease;
}

.protection-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

.rights-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.right-item {
    display: flex;
    align-items: center;
    padding: 20px;
    background: #f8f9fa;
    border-radius: 10px;
    transition: transform 0.3s ease;
}

.right-item:hover {
    transform: translateX(10px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.right-item i {
    font-size: 1.5rem;
    margin-right: 20px;
    width: 40px;
    text-align: center;
}

.contact-security {
    background: #f8f9fa;
    padding: 30px;
    border-radius: 15px;
    border-left: 5px solid #667eea;
}

.contact-info {
    background: white;
    padding: 20px;
    border-radius: 10px;
    margin-top: 20px;
}

.alert {
    border-radius: 10px;
    border: none;
}

.alert-info {
    background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
    color: #1565c0;
}

.alert-warning {
    background: linear-gradient(135deg, #fff3e0 0%, #ffcc02 100%);
    color: #e65100;
}
</style>