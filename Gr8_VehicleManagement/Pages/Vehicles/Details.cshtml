@page
@model Gr8_VehicleManagement.Pages.Vehicles.DetailsModel
@{
    ViewData["Title"] = Model.Vehicle?.Name ?? "Chi Tiết Xe";
}

<div class="container-fluid mt-4">
    @if (Model.Vehicle == null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> Không tìm thấy xe
        </div>
        <a href="/Vehicles" class="btn btn-secondary">Quay lại danh sách</a>
        return;
    }

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/Vehicles">Danh sách xe</a></li>
            <li class="breadcrumb-item active">@Model.Vehicle.Name</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1><i class="bi bi-car-front"></i> @Model.Vehicle.Name</h1>
            <p class="lead text-muted">@Model.Vehicle.Category</p>
        </div>
        <div class="col-md-4 text-end">
            @if (Model.CanEdit)
            {
                <a href="/Vehicles/Edit?id=@Model.Vehicle.Id" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Sửa
                </a>
            }
            @if (Model.CanDelete)
            {
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                    <i class="bi bi-trash"></i> Xóa
                </button>
            }
        </div>
    </div>

    <!-- Main Content -->
    <div class="row">
        <!-- Images -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    @if (Model.Vehicle.Images.Any())
                    {
                        var mainImage = Model.Vehicle.Images.FirstOrDefault(i => i.IsDefault) ?? Model.Vehicle.Images.First();
                        <div id="vehicleCarousel" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                @for (int i = 0; i < Model.Vehicle.Images.Count; i++)
                                {
                                    var img = Model.Vehicle.Images[i];
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img src="@img.ImageUrl" class="d-block w-100" alt="@Model.Vehicle.Name" style="height: 400px; object-fit: cover;" />
                                    </div>
                                }
                            </div>
                            @if (Model.Vehicle.Images.Count > 1)
                            {
                                <button class="carousel-control-prev" type="button" data-bs-target="#vehicleCarousel" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon"></span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#vehicleCarousel" data-bs-slide="next">
                                    <span class="carousel-control-next-icon"></span>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 bg-light">
                            <i class="bi bi-image text-muted" style="font-size: 6rem;"></i>
                            <p class="text-muted mt-3">Chưa có hình ảnh</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Info -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Thông Tin Xe</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="30%">Mã xe:</th>
                            <td><strong>@Model.Vehicle.Code</strong></td>
                        </tr>
                        <tr>
                            <th>Loại xe:</th>
                            <td><span class="badge bg-info">@Model.Vehicle.Category</span></td>
                        </tr>
                        <tr>
                            <th>Giá bán:</th>
                            <td class="text-primary">
                                <strong>
                                    @if (Model.Vehicle.MinPrice.HasValue && Model.Vehicle.MaxPrice.HasValue)
                                    {
                                        @Model.Vehicle.MinPrice.Value.ToString("N0")
                                        @if (Model.Vehicle.MinPrice.Value != Model.Vehicle.MaxPrice.Value)
                                        {
                                            <span> - @Model.Vehicle.MaxPrice.Value.ToString("N0")</span>
                                        }
                                        <span> VNĐ</span>
                                    }
                                    else
                                    {
                                        <span>Liên hệ</span>
                                    }
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <th>Số phiên bản:</th>
                            <td>@Model.Vehicle.VersionCount phiên bản</td>
                        </tr>
                        <tr>
                            <th>Tồn kho:</th>
                            <td>@Model.Vehicle.InventoryCount xe</td>
                        </tr>
                        <tr>
                            <th>Ngày ra mắt:</th>
                            <td>@(Model.Vehicle.LaunchedAt?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</td>
                        </tr>
                        <tr>
                            <th>Trạng thái:</th>
                            <td>
                                @if (Model.Vehicle.IsActive)
                                {
                                    <span class="badge bg-success">Đang kinh doanh</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Ngừng kinh doanh</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Description -->
    @if (!string.IsNullOrEmpty(Model.Vehicle.Description))
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-file-text"></i> Mô Tả</h5>
            </div>
            <div class="card-body">
                <p>@Model.Vehicle.Description</p>
            </div>
        </div>
    }

    <!-- Versions -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-palette"></i> Các Phiên Bản (@Model.Versions.Count)</h5>
        </div>
        <div class="card-body">
            @if (Model.Versions.Any())
            {
                <div class="row g-3">
                    @foreach (var version in Model.Versions)
                    {
                        <div class="col-md-6">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        @version.VersionName 
                                        <span class="badge" style="background-color: @(version.ColorCode ?? "#ccc");">
                                            @version.ColorName
                                        </span>
                                    </h6>
                                    
                                    <div class="row g-2 small text-muted mb-3">
                                        @if (version.BatteryCapacity.HasValue)
                                        {
                                            <div class="col-6">
                                                <i class="bi bi-battery-charging"></i> @version.BatteryCapacity kWh
                                            </div>
                                        }
                                        @if (version.Range.HasValue)
                                        {
                                            <div class="col-6">
                                                <i class="bi bi-speedometer"></i> @version.Range km
                                            </div>
                                        }
                                        @if (version.MaxSpeed.HasValue)
                                        {
                                            <div class="col-6">
                                                <i class="bi bi-speedometer2"></i> @version.MaxSpeed km/h
                                            </div>
                                        }
                                        @if (version.SeatingCapacity.HasValue)
                                        {
                                            <div class="col-6">
                                                <i class="bi bi-people"></i> @version.SeatingCapacity chỗ
                                            </div>
                                        }
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong class="text-primary">@version.SellingPrice.ToString("N0") VNĐ</strong>
                                            <br />
                                            <small class="text-muted">Tồn kho: @version.AvailableStock xe</small>
                                        </div>
                                        @if (version.IsActive)
                                        {
                                            <span class="badge bg-success">Có sẵn</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Hết hàng</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">Chưa có phiên bản nào</p>
            }
        </div>
    </div>

    <!-- Back Button -->
    <div class="mb-4">
        <a href="/Vehicles" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc muốn xóa mẫu xe <strong>@Model.Vehicle?.Name</strong>?</p>
                <p class="text-danger">Hành động này không thể hoàn tác!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Vehicle?.Id" class="d-inline">
                    <button type="submit" class="btn btn-danger">Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>

