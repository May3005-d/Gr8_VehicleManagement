@page
@model Gr8_VehicleManagement.Pages.AboutModel
@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="container-fluid page-about">
    <!-- Hero Section -->
    <div class="row hero-section">
        <div class="col-12">
            <div class="hero-content">
                <h1 class="display-4 fw-bold text-white mb-4">GR8 DEALER MANAGEMENT</h1>
                <p class="lead text-white mb-5">Hệ thống quản lý xe chuyên nghiệp - Tin cậy, Hiệu quả, Hiện đại</p>
            </div>
        </div>
    </div>

    <!-- About Content -->
    <div class="container py-5">
        <div class="row">
            <!-- Company Image -->
            <div class="col-lg-6 mb-5">
                <div class="image-container">
                    <img src="https://photo.znews.vn/w660/Uploaded/bgtngt/2020_07_29/736123.jpg" 
                         alt="Xe đẹp - GR8 Vehicle Management" 
                         class="img-fluid rounded shadow-lg">
                </div>
            </div>
            
            <!-- Company Info -->
            <div class="col-lg-6">
                <h2 class="h3 mb-4 text-primary">Về chúng tôi</h2>
                <p class="lead mb-4">
                    GR8 Vehicle Management là hệ thống quản lý xe hàng đầu, được thiết kế để đáp ứng mọi nhu cầu 
                    của các đại lý xe, showroom và doanh nghiệp trong ngành ô tô.
                </p>
                
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="feature-item">
                            <i class="fas fa-car text-primary mb-2"></i>
                            <h5>Quản lý xe</h5>
                            <p class="text-muted">Theo dõi tồn kho, thông tin xe chi tiết</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="feature-item">
                            <i class="fas fa-users text-primary mb-2"></i>
                            <h5>Quản lý khách hàng</h5>
                            <p class="text-muted">Lưu trữ thông tin khách hàng toàn diện</p>
                        </div>
                    </div>
                </div>
                
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="feature-item">
                            <i class="fas fa-shopping-cart text-primary mb-2"></i>
                            <h5>Quản lý đơn hàng</h5>
                            <p class="text-muted">Xử lý đơn hàng nhanh chóng, chính xác</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="feature-item">
                            <i class="fas fa-chart-line text-primary mb-2"></i>
                            <h5>Báo cáo thống kê</h5>
                            <p class="text-muted">Phân tích dữ liệu, báo cáo chi tiết</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mission & Vision -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">
                        <div class="row">
                            <div class="col-md-6">
                                <h3 class="text-primary mb-3">
                                    <i class="fas fa-bullseye me-2"></i>Sứ mệnh
                                </h3>
                                <p class="text-muted">
                                    Chúng tôi cam kết cung cấp giải pháp quản lý xe toàn diện, giúp các doanh nghiệp 
                                    tối ưu hóa quy trình kinh doanh và nâng cao hiệu quả hoạt động.
                                </p>
                            </div>
                            <div class="col-md-6">
                                <h3 class="text-primary mb-3">
                                    <i class="fas fa-eye me-2"></i>Tầm nhìn
                                </h3>
                                <p class="text-muted">
                                    Trở thành hệ thống quản lý xe hàng đầu Việt Nam, được tin tưởng bởi hàng nghìn 
                                    doanh nghiệp trong ngành ô tô.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Features -->
        <div class="row mt-5">
            <div class="col-12">
                <h2 class="text-center mb-5">Tính năng nổi bật</h2>
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-shield-alt text-primary mb-3" style="font-size: 3rem;"></i>
                        <h5 class="card-title">Bảo mật cao</h5>
                        <p class="card-text text-muted">
                            Hệ thống bảo mật đa lớp, đảm bảo an toàn tuyệt đối cho dữ liệu khách hàng.
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-mobile-alt text-primary mb-3" style="font-size: 3rem;"></i>
                        <h5 class="card-title">Responsive Design</h5>
                        <p class="card-text text-muted">
                            Giao diện thân thiện, tương thích mọi thiết bị từ desktop đến mobile.
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-cogs text-primary mb-3" style="font-size: 3rem;"></i>
                        <h5 class="card-title">Dễ sử dụng</h5>
                        <p class="card-text text-muted">
                            Giao diện trực quan, dễ dàng sử dụng cho mọi đối tượng người dùng.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="bg-primary text-white rounded p-5">
                    <div class="row text-center">
                        <div class="col-md-3 mb-3">
                            <h3 class="display-4 fw-bold">1000+</h3>
                            <p class="mb-0">Khách hàng tin tưởng</p>
                        </div>
                        <div class="col-md-3 mb-3">
                            <h3 class="display-4 fw-bold">5000+</h3>
                            <p class="mb-0">Xe được quản lý</p>
                        </div>
                        <div class="col-md-3 mb-3">
                            <h3 class="display-4 fw-bold">99.9%</h3>
                            <p class="mb-0">Thời gian hoạt động</p>
                        </div>
                        <div class="col-md-3 mb-3">
                            <h3 class="display-4 fw-bold">24/7</h3>
                            <p class="mb-0">Hỗ trợ khách hàng</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
