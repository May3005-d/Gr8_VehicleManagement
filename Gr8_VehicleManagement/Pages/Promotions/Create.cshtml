@page
@model Gr8_VehicleManagement.Pages.Promotions.CreateModel
@{
    ViewData["Title"] = "Tạo Khuyến Mãi Mới";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1><i class="bi bi-plus-circle"></i> Tạo Khuyến Mãi Mới</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="/Promotions" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay Lại
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Thông Tin Khuyến Mãi</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.Code" class="form-label">Mã Khuyến Mãi *</label>
                                <input asp-for="Input.Code" class="form-control" placeholder="VD: SUMMER2024" />
                                <span asp-validation-for="Input.Code" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Input.Name" class="form-label">Tên Khuyến Mãi *</label>
                                <input asp-for="Input.Name" class="form-control" placeholder="VD: Khuyến mãi mùa hè 2024" />
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-12">
                                <label asp-for="Input.Description" class="form-label">Mô Tả</label>
                                <textarea asp-for="Input.Description" class="form-control" rows="3" placeholder="Mô tả chi tiết về khuyến mãi..."></textarea>
                                <span asp-validation-for="Input.Description" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Input.DiscountType" class="form-label">Loại Giảm Giá *</label>
                                <select asp-for="Input.DiscountType" class="form-select" id="discountType">
                                    <option value="">Chọn loại giảm giá</option>
                                    <option value="0">Phần trăm (%)</option>
                                    <option value="1">Số tiền cố định (VNĐ)</option>
                                </select>
                                <span asp-validation-for="Input.DiscountType" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Input.DiscountValue" class="form-label">Giá Trị Giảm Giá *</label>
                                <div class="input-group">
                                    <input asp-for="Input.DiscountValue" type="number" step="0.01" class="form-control" placeholder="VD: 10" />
                                    <span class="input-group-text" id="discountUnit">%</span>
                                </div>
                                <span asp-validation-for="Input.DiscountValue" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Input.MinOrderValue" class="form-label">Giá Trị Đơn Hàng Tối Thiểu (VNĐ)</label>
                                <input asp-for="Input.MinOrderValue" type="number" step="0.01" class="form-control" placeholder="VD: 1000000" />
                                <small class="text-muted">Để trống nếu không có yêu cầu</small>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Input.MaxDiscountAmount" class="form-label">Giảm Giá Tối Đa (VNĐ)</label>
                                <input asp-for="Input.MaxDiscountAmount" type="number" step="0.01" class="form-control" placeholder="VD: 500000" />
                                <small class="text-muted">Chỉ áp dụng với giảm giá phần trăm</small>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Input.UsageLimit" class="form-label">Giới Hạn Sử Dụng</label>
                                <input asp-for="Input.UsageLimit" type="number" class="form-control" placeholder="VD: 100" />
                                <small class="text-muted">Để trống nếu không giới hạn</small>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Input.StartDate" class="form-label">Ngày Bắt Đầu *</label>
                                <input asp-for="Input.StartDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="Input.StartDate" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Input.EndDate" class="form-label">Ngày Kết Thúc *</label>
                                <input asp-for="Input.EndDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="Input.EndDate" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Input.TargetAudience" class="form-label">Đối Tượng Áp Dụng</label>
                                <select asp-for="Input.TargetAudience" class="form-select">
                                    <option value="">Tất cả khách hàng</option>
                                    <option value="VIP">Khách hàng VIP</option>
                                    <option value="NEW">Khách hàng mới</option>
                                    <option value="REGULAR">Khách hàng thường</option>
                                </select>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Input.ApplicableVehicles" class="form-label">Xe Áp Dụng</label>
                                <input asp-for="Input.ApplicableVehicles" class="form-control" placeholder="VD: Tesla Model 3, BMW i3" />
                                <small class="text-muted">Để trống nếu áp dụng cho tất cả xe</small>
                            </div>
                            
                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="Input.IsActive" class="form-check-input" />
                                    <label asp-for="Input.IsActive" class="form-check-label">
                                        Kích hoạt khuyến mãi ngay
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle"></i> Tạo Khuyến Mãi
                                </button>
                                <a href="/Promotions" class="btn btn-outline-secondary ms-2">
                                    <i class="bi bi-x-circle"></i> Hủy
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">Hướng Dẫn</h6>
                </div>
                <div class="card-body">
                    <h6>Thông Tin Bắt Buộc:</h6>
                    <ul class="small">
                        <li><strong>Mã khuyến mãi:</strong> Mã duy nhất (VD: SUMMER2024)</li>
                        <li><strong>Tên khuyến mãi:</strong> Tên hiển thị</li>
                        <li><strong>Loại giảm giá:</strong> Phần trăm hoặc cố định</li>
                        <li><strong>Giá trị:</strong> Số tiền hoặc % giảm</li>
                        <li><strong>Thời gian:</strong> Ngày bắt đầu và kết thúc</li>
                    </ul>
                    
                    <h6 class="mt-3">Thông Tin Tùy Chọn:</h6>
                    <ul class="small">
                        <li><strong>Giá trị tối thiểu:</strong> Đơn hàng phải đạt mức này</li>
                        <li><strong>Giảm giá tối đa:</strong> Giới hạn cho giảm giá %</li>
                        <li><strong>Giới hạn sử dụng:</strong> Số lần sử dụng tối đa</li>
                        <li><strong>Đối tượng:</strong> Khách hàng nào được áp dụng</li>
                        <li><strong>Xe áp dụng:</strong> Loại xe nào được áp dụng</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('discountType').addEventListener('change', function() {
            const unit = document.getElementById('discountUnit');
            const discountValue = document.querySelector('input[name="Input.DiscountValue"]');
            
            if (this.value === '0') { // Percentage
                unit.textContent = '%';
                discountValue.placeholder = 'VD: 10';
            } else { // Fixed amount
                unit.textContent = 'VNĐ';
                discountValue.placeholder = 'VD: 100000';
            }
        });
    </script>
}
