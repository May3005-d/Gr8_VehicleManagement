@page
@model Gr8_VehicleManagement.Pages.Feedbacks.IndexModel
@{
    ViewData["Title"] = "Phản Hồi & Khiếu Nại";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-6">
            <h2 class="mb-0">
                <i class="bi bi-chat-dots"></i> Phản Hồi & Khiếu Nại
            </h2>
            <p class="text-muted">Quản lý phản hồi và khiếu nại từ khách hàng</p>
        </div>
        <div class="col-md-6 text-end">
            @if (Model.CanCreate)
            {
                <a href="/Feedbacks/Create" class="btn btn-primary btn-custom">
                    <i class="bi bi-plus-circle me-2"></i> Tạo Phản Hồi Mới
                </a>
            }
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">@Model.TotalFeedbacks</h4>
                            <p class="card-text">Tổng Phản Hồi</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-chat-dots fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">@Model.OpenFeedbacks</h4>
                            <p class="card-text">Đang Xử Lý</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-clock fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">@Model.OverdueFeedbacks</h4>
                            <p class="card-text">Quá Hạn</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-exclamation-triangle fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">@Model.AverageResolutionTime.ToString("F1") ngày</h4>
                            <p class="card-text">Thời Gian TB</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-graph-up fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Tìm kiếm</label>
                    <input type="text" class="form-control" name="searchTerm" value="@Model.SearchTerm" placeholder="Tiêu đề, mô tả...">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Loại</label>
                    <select class="form-select" name="feedbackType">
                        <option value="">Tất cả</option>
                        <option value="Complaint" selected="@(Model.FeedbackType == "Complaint")">Khiếu nại</option>
                        <option value="Suggestion" selected="@(Model.FeedbackType == "Suggestion")">Góp ý</option>
                        <option value="Question" selected="@(Model.FeedbackType == "Question")">Câu hỏi</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Trạng thái</label>
                    <select class="form-select" name="status">
                        <option value="">Tất cả</option>
                        <option value="Open" selected="@(Model.Status == "Open")">Mở</option>
                        <option value="InProgress" selected="@(Model.Status == "InProgress")">Đang xử lý</option>
                        <option value="Resolved" selected="@(Model.Status == "Resolved")">Đã giải quyết</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Ưu tiên</label>
                    <select class="form-select" name="priority">
                        <option value="">Tất cả</option>
                        <option value="Low" selected="@(Model.Priority == "Low")">Thấp</option>
                        <option value="Medium" selected="@(Model.Priority == "Medium")">Trung bình</option>
                        <option value="High" selected="@(Model.Priority == "High")">Cao</option>
                        <option value="Critical" selected="@(Model.Priority == "Critical")">Khẩn cấp</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Quá hạn</label>
                    <select class="form-select" name="isOverdue">
                        <option value="">Tất cả</option>
                        <option value="true" selected="@(Model.IsOverdue == true)">Có</option>
                        <option value="false" selected="@(Model.IsOverdue == false)">Không</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-outline-primary d-block w-100">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Feedbacks Table -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Danh Sách Phản Hồi</h5>
        </div>
        <div class="card-body">
            @if (Model.Feedbacks.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Tiêu Đề</th>
                                <th>Loại</th>
                                <th>Trạng Thái</th>
                                <th>Ưu Tiên</th>
                                <th>Khách Hàng</th>
                                <th>Người Xử Lý</th>
                                <th>Ngày Tạo</th>
                                <th>Thời Gian</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var feedback in Model.Feedbacks)
                            {
                                <tr class="@(feedback.IsOverdue ? "table-danger" : "")">
                                    <td>
                                        <div>
                                            <strong>@feedback.Title</strong>
                                            @if (!string.IsNullOrEmpty(feedback.Description))
                                            {
                                                <br><small class="text-muted">@(feedback.Description.Length > 50 ? feedback.Description.Substring(0, 50) + "..." : feedback.Description)</small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-@(feedback.FeedbackType.ToString() == "Complaint" ? "danger" : feedback.FeedbackType.ToString() == "Suggestion" ? "info" : "secondary")">
                                            @feedback.FeedbackTypeDisplay
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@(feedback.Status.ToString() == "Resolved" ? "success" : feedback.Status.ToString() == "InProgress" ? "warning" : "primary")">
                                            @feedback.StatusDisplay
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@(feedback.Priority.ToString() == "Critical" ? "danger" : feedback.Priority.ToString() == "High" ? "warning" : feedback.Priority.ToString() == "Medium" ? "info" : "secondary")">
                                            @feedback.PriorityDisplay
                                        </span>
                                    </td>
                                    <td>
                                        <div>
                                            <strong>@feedback.CustomerName</strong>
                                            @if (!string.IsNullOrEmpty(feedback.CustomerEmail))
                                            {
                                                <br><small class="text-muted">@feedback.CustomerEmail</small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(feedback.AssignedUserName))
                                        {
                                            <span>@feedback.AssignedUserName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa phân công</span>
                                        }
                                    </td>
                                    <td>
                                        <div>
                                            <small>@feedback.CreatedAt.ToString("dd/MM/yyyy")</small>
                                            <br><small class="text-muted">@feedback.CreatedAt.ToString("HH:mm")</small>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <strong>@feedback.DaysOpen ngày</strong>
                                            @if (feedback.IsOverdue)
                                            {
                                                <br><small class="text-danger">Quá hạn</small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="/Feedbacks/Details?id=@feedback.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (Model.CanEdit)
                                            {
                                                <a href="/Feedbacks/Edit?id=@feedback.Id" class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Feedbacks pagination">
                        <ul class="pagination justify-content-center">
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?pageNumber=@(Model.CurrentPage - 1)&searchTerm=@Model.SearchTerm&feedbackType=@Model.FeedbackType&status=@Model.Status&priority=@Model.Priority&isOverdue=@Model.IsOverdue">Trước</a>
                                </li>
                            }
                            
                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="?pageNumber=@i&searchTerm=@Model.SearchTerm&feedbackType=@Model.FeedbackType&status=@Model.Status&priority=@Model.Priority&isOverdue=@Model.IsOverdue">@i</a>
                                </li>
                            }
                            
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?pageNumber=@(Model.CurrentPage + 1)&searchTerm=@Model.SearchTerm&feedbackType=@Model.FeedbackType&status=@Model.Status&priority=@Model.Priority&isOverdue=@Model.IsOverdue">Sau</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-chat-dots fs-1 text-muted"></i>
                    <h5 class="text-muted mt-3">Chưa có phản hồi nào</h5>
                    <p class="text-muted">Hãy tạo phản hồi đầu tiên để bắt đầu quản lý.</p>
                    @if (Model.CanCreate)
                    {
                        <a href="/Feedbacks/Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i> Tạo Phản Hồi Đầu Tiên
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>